# =============================================================================
# BeatSight Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# Enable debug mode (never enable in production!)
DEBUG=false

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string (async driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_DSN=postgresql+asyncpg://beatsight:beatsight@localhost:5432/beatsight

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# REDIS / CACHING
# -----------------------------------------------------------------------------
# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 1 hour)
CACHE_DEFAULT_TTL=3600

# -----------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a secure secret for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECURE_RANDOM_VALUE

# JWT algorithm (HS256 recommended for symmetric)
JWT_ALGORITHM=HS256

# Token expiry times (in minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Use JSON structured logging (recommended for production)
LOGGING_JSON=false

# Log to file (leave empty to disable)
LOG_FILE_PATH=

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Use * for development only, never in production!
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Storage backend: local, azure_blob, s3
STORAGE_BACKEND=local

# Local storage path (relative to app root)
STORAGE_LOCAL_PATH=./storage

# Azure Blob Storage (if STORAGE_BACKEND=azure_blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=beatsight

# AWS S3 (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=beatsight

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=100

# -----------------------------------------------------------------------------
# AI PIPELINE
# -----------------------------------------------------------------------------
# Path to AI pipeline directory
AI_PIPELINE_PATH=../ai-pipeline

# ML model path (leave empty for auto-detection)
ML_MODEL_PATH=

# Use ML classifier (true) or heuristic fallback (false)
USE_ML_CLASSIFIER=true

# GPU device for inference (-1 for CPU)
AI_GPU_DEVICE=-1

# Job queue settings
AI_JOB_TIMEOUT_SECONDS=600
AI_MAX_CONCURRENT_JOBS=2

# -----------------------------------------------------------------------------
# MODAL.COM GPU ORCHESTRATION
# -----------------------------------------------------------------------------
# Enable Modal.com for GPU-accelerated processing
# When disabled, jobs run locally (slower, for development only)
MODAL_ENABLED=false

# Modal API credentials (get from https://modal.com/settings)
# Create tokens at: https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal app name (must match ai-pipeline/modal_app.py)
MODAL_APP_NAME=beatsight-ai

# Modal environment (main, dev, staging)
MODAL_ENVIRONMENT=main

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Default rate limit (requests per minute)
RATE_LIMIT_DEFAULT=60

# AI job rate limit (jobs per hour per user)
RATE_LIMIT_AI_JOBS=10

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------------------------------
# MusicBrainz API (for metadata lookups)
MUSICBRAINZ_APP_NAME=BeatSight
MUSICBRAINZ_APP_VERSION=1.0.0
MUSICBRAINZ_CONTACT_EMAIL=

# Sentry error tracking (leave empty to disable)
SENTRY_DSN=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Trusted proxy headers (for running behind a reverse proxy)
# Options: none, x-forwarded-for, cf-connecting-ip
TRUSTED_PROXY_HEADERS=none

# Content Security Policy (CSP) report URI
CSP_REPORT_URI=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable beatmap sharing/community features
FEATURE_COMMUNITY=true

# Enable karma/reputation system
FEATURE_KARMA=true

# Enable cloud sync for beatmaps
FEATURE_CLOUD_SYNC=false

# Enable beta features
FEATURE_BETA=false

# -----------------------------------------------------------------------------
# STRIPE (PAYMENTS)
# -----------------------------------------------------------------------------
# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook secret (get from Stripe dashboard when creating webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for subscription plans
# Create these in Stripe dashboard under Products > Prices
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
