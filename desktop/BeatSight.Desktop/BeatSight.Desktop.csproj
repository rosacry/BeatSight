<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <AssemblyName>BeatSight</AssemblyName>
    <Product>BeatSight</Product>
    <Description>AI-powered drum transcription and practice tool</Description>
    <Company>BeatSight</Company>
    <Copyright>© 2025 BeatSight</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeatSight.Game\BeatSight.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Using latest available versions from NuGet.org - framework auto-requires matching NativeLibs -->
    <PackageReference Include="ppy.osu.Framework" Version="2025.1028.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="metronome_sounds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
