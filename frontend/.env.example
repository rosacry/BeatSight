# =============================================================================
# BeatSight Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# These are exposed to the browser - DO NOT put secrets here!
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API URL (relative path uses Vite proxy in development)
VITE_API_BASE_URL=/api

# WebSocket URL for real-time updates (optional)
# VITE_WS_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable PWA features (install prompt, offline mode)
VITE_ENABLE_PWA=true

# Enable debug mode (shows extra logging, dev tools)
VITE_DEBUG=false

# Enable mock API responses (for development without backend)
VITE_USE_MOCKS=false

# -----------------------------------------------------------------------------
# Third-Party Services
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=

# Analytics ID (optional)
# VITE_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# App display name
VITE_APP_NAME=BeatSight

# Max file upload size in bytes (default: 100MB)
VITE_MAX_UPLOAD_SIZE=104857600

# Supported audio formats
VITE_SUPPORTED_FORMATS=.mp3,.wav,.flac,.ogg,.m4a
