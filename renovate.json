{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "group:allNonMajor",
        ":separateMajorReleases",
        ":prHourlyLimitNone",
        ":prConcurrentLimit10"
    ],
    "labels": [
        "dependencies"
    ],
    "schedule": [
        "before 9am on monday"
    ],
    "timezone": "America/Los_Angeles",
    "prBodyNotes": [
        "This PR was auto-generated by [Renovate Bot](https://renovatebot.com)."
    ],
    "packageRules": [
        {
            "description": "Group all non-major updates",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "all non-major dependencies"
        },
        {
            "description": "Auto-merge patch updates for well-tested packages",
            "matchUpdateTypes": [
                "patch"
            ],
            "matchPackagePatterns": [
                "^@types/",
                "^eslint",
                "^prettier"
            ],
            "automerge": true
        },
        {
            "description": "Frontend dependencies",
            "matchFileNames": [
                "frontend/package.json"
            ],
            "labels": [
                "dependencies",
                "frontend"
            ],
            "commitMessageSuffix": "(frontend)"
        },
        {
            "description": "Backend dependencies",
            "matchFileNames": [
                "backend/pyproject.toml"
            ],
            "labels": [
                "dependencies",
                "backend"
            ],
            "commitMessageSuffix": "(backend)"
        },
        {
            "description": "AI Pipeline dependencies",
            "matchFileNames": [
                "ai-pipeline/requirements.txt"
            ],
            "labels": [
                "dependencies",
                "ai-pipeline"
            ],
            "commitMessageSuffix": "(ai-pipeline)"
        },
        {
            "description": "Desktop dependencies",
            "matchFileNames": [
                "desktop/**/*.csproj"
            ],
            "labels": [
                "dependencies",
                "desktop"
            ],
            "commitMessageSuffix": "(desktop)"
        },
        {
            "description": "Don't update React to 19.x yet (breaking changes)",
            "matchPackageNames": [
                "react",
                "react-dom",
                "@types/react",
                "@types/react-dom"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "description": "Don't update PyTorch automatically (breaking ML changes)",
            "matchPackageNames": [
                "torch",
                "torchaudio",
                "torchvision"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "description": "Pin Python ML dependencies for reproducibility",
            "matchFileNames": [
                "ai-pipeline/requirements.txt"
            ],
            "matchPackagePatterns": [
                "torch",
                "librosa",
                "demucs",
                "onnx"
            ],
            "rangeStrategy": "pin"
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": [
            "security"
        ]
    }
}